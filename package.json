{
  "name": "bryntime",
  "version": "0.5.0",
  "description": "Python and JavaScript reading each other's values in a page, on Brython's engine, behind one door a framework answers through a host",
  "author": "Florent Gallaire <fgallaire@gmail.com>",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svelthon/bryntime.git"
  },
  "bugs": {
    "url": "https://github.com/svelthon/bryntime/issues"
  },
  "keywords": [
    "python",
    "brython",
    "runtime",
    "javascript"
  ],
  "type": "module",
  "main": "./src/bryntime.js",
  "exports": {
    ".": "./src/bryntime.js",
    "./compiler": "./vendor/brython_compiler.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "vendor"
  ],
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include='src/**'"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.12"
  }
}
